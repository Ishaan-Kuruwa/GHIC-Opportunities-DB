---
import type { Opportunity } from "../data/types";
import RatingMeter from "./RatingMeter.astro";

interface Props {
  opportunity: Opportunity;
}

const { opportunity } = Astro.props;
---

<article class="h-full rounded-sm border border-hairline bg-tile transition-colors hover:border-accent">
  <a
    href={`/opportunity/${opportunity.id}`}
    class="block h-full rounded-sm p-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <h2 class="text-lg leading-snug font-semibold text-ink">{opportunity.name}</h2>

    <p class="mt-1 text-sm text-ink-muted">
      {opportunity.type} &middot; {opportunity.category}
    </p>

    {/*
      Prestige tier shows the data value verbatim -- we deliberately don't parse
      a short "Tier 1" out of it. A proper short label belongs in the data file
      (planned for Phase 7), not in a string-slicing rule here that breaks the
      moment someone words a tier differently.
    */}
    <p class="mt-3">
      <span class="inline-block rounded-sm bg-pill-fill px-2 py-0.5 text-xs font-medium text-ink-muted">
        {opportunity.prestigeTier}
      </span>
    </p>

    <p class="mt-2 text-sm text-ink-muted">{opportunity.cost}</p>

    <div class="mt-4">
      <RatingMeter ratings={opportunity.ratings} />
    </div>
  </a>
</article>
