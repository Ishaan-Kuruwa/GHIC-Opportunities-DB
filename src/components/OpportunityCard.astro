---
import type { Opportunity } from "../data/types";

interface Props {
  opportunity: Opportunity;
}

const { opportunity } = Astro.props;

const ratingEntries: [string, number][] = [
  ["Effort", opportunity.ratings.effort],
  ["Competitiveness", opportunity.ratings.competitiveness],
  ["Skills", opportunity.ratings.skills],
  ["Prestige", opportunity.ratings.prestige],
  ["Club fit", opportunity.ratings.clubFit],
  ["Accessibility", opportunity.ratings.accessibility],
];
---

<article class="h-full rounded-lg border border-gray-200 shadow-sm transition hover:shadow-md">
  <a
    href="#"
    class="block h-full rounded-lg p-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
  >
    <h2 class="text-lg font-semibold leading-snug text-gray-900">{opportunity.name}</h2>

    <p class="mt-1 text-sm text-gray-600">
      {opportunity.type} &middot; {opportunity.category}
    </p>

    <p class="mt-2 text-sm text-gray-700">{opportunity.prestigeTier}</p>
    <p class="mt-1 text-sm text-gray-700">{opportunity.cost}</p>

    <dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 text-sm">
      {ratingEntries.map(([label, value]) => (
        <div class="flex justify-between gap-2">
          <dt class="text-gray-500">{label}</dt>
          <dd class="font-medium text-gray-900">{value}/10</dd>
        </div>
      ))}
    </dl>
  </a>
</article>
