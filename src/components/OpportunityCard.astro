---
import type { Opportunity } from "../data/types";
import RatingMeter from "./RatingMeter.astro";

interface Props {
  opportunity: Opportunity;
}

const { opportunity } = Astro.props;
---

<article class="h-full">
  <a
    href={`/opportunity/${opportunity.id}`}
    class="shadow-brutal block h-full border-4 border-ink bg-surface p-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    {/*
      Heavy weight, but deliberately NOT uppercase: names come straight from
      opportunities.json and run up to 95 characters (confirmed against the
      real data) -- full-caps at display weight would hurt legibility and
      risk ugly wrapping. Chrome labels (buttons, section headers) get
      uppercase; anything pulled from the data file never does.
    */}
    <h2 class="text-lg leading-snug font-black text-ink">{opportunity.name}</h2>

    <p class="mt-1 text-sm text-ink-muted">
      {opportunity.type} &middot; {opportunity.category}
    </p>

    {/*
      Prestige tier shows the data value verbatim -- we deliberately don't parse
      a short "Tier 1" out of it. A proper short label belongs in the data file
      (planned for Phase 7), not in a string-slicing rule here that breaks the
      moment someone words a tier differently.
    */}
    <p class="mt-3">
      {/* Same data-driven exception as the name above -- this field runs up
          to 63 characters of free-text commentary, so it stays regular
          weight and mixed case, not uppercase, even though it's now a
          bordered chip instead of a soft pill. */}
      <span class="inline-block border-4 border-ink bg-pill-fill px-2 py-0.5 text-xs font-medium text-ink">
        {opportunity.prestigeTier}
      </span>
    </p>

    <p class="mt-2 text-sm text-ink-muted">{opportunity.cost}</p>

    <div class="mt-4">
      <RatingMeter ratings={opportunity.ratings} />
    </div>
  </a>
</article>
