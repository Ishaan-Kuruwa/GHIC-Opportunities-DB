---
import type { Facets } from "../data/types";

interface Props {
  facets: Facets;
  total: number;
}

const { facets, total } = Astro.props;

// Effort/Competitiveness/Skills are "easier is lower" -- a student filters for
// AT MOST a threshold ("5 or less"). Club fit is "better is higher" -- a student
// filters for AT LEAST a threshold ("8+"). Same control, opposite direction, so
// this one array drives all four <select>s uniformly; only the label/options differ,
// not the markup. filters.js applies the matching comparison per field.
const rangeFilters = [
  {
    id: "filter-max-effort",
    field: "effort",
    param: "maxEffort",
    comparator: "max",
    label: "Effort",
    options: [
      { value: "", label: "Any" },
      { value: "3", label: "3 or less" },
      { value: "5", label: "5 or less" },
      { value: "7", label: "7 or less" },
    ],
  },
  {
    id: "filter-max-competitiveness",
    field: "competitiveness",
    param: "maxCompetitiveness",
    comparator: "max",
    label: "Competitiveness",
    options: [
      { value: "", label: "Any" },
      { value: "3", label: "3 or less" },
      { value: "5", label: "5 or less" },
      { value: "7", label: "7 or less" },
    ],
  },
  {
    id: "filter-max-skills",
    field: "skills",
    param: "maxSkills",
    comparator: "max",
    label: "Skills",
    options: [
      { value: "", label: "Any" },
      { value: "3", label: "3 or less" },
      { value: "5", label: "5 or less" },
      { value: "7", label: "7 or less" },
    ],
  },
  {
    id: "filter-min-club-fit",
    field: "clubFit",
    param: "minClubFit",
    comparator: "min",
    label: "Club fit",
    options: [
      { value: "", label: "Any" },
      { value: "6", label: "6+" },
      { value: "8", label: "8+" },
    ],
  },
];

const selectClass =
  "mt-1 w-full rounded-sm border border-rule bg-surface p-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const labelClass = "block text-sm font-medium text-ink-muted";
---

<div class="filters mt-6 rounded-sm border border-rule bg-pill-fill p-4" id="filter-bar">
  <div>
    <label for="filter-search" class={labelClass}>Search</label>
    <input
      type="search"
      id="filter-search"
      placeholder="Name, organizer, description..."
      class={selectClass}
    />
  </div>

  <!--
    Type/category/ranges/checkboxes collapse behind this <summary> on narrow
    screens -- eight controls plus search was pushing every opportunity card
    below the fold on a phone. <details> gives us the expand/collapse behavior
    natively, no JS required for the mechanic itself. filters.js sets `open`
    based on screen width on load (open on desktop, closed on mobile) and
    keeps the "Filters (N)" count in the summary in sync with active filters,
    so someone who scrolls past a closed, collapsed panel can still see that
    filters are active.
  -->
  <details class="mt-3" id="filter-details">
    <summary
      id="filter-summary"
      class="cursor-pointer text-sm font-medium text-ink-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      Filters
    </summary>

    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <label for="filter-type" class={labelClass}>Type</label>
        <select id="filter-type" class={selectClass}>
          <option value="">All types</option>
          {facets.types.map((type) => <option value={type}>{type}</option>)}
        </select>
      </div>

      <div>
        <label for="filter-category" class={labelClass}>Category</label>
        <select id="filter-category" class={selectClass}>
          <option value="">All categories</option>
          {facets.categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>

      {rangeFilters.map((filter) => (
        <div>
          <label for={filter.id} class={labelClass}>{filter.label}</label>
          <select
            id={filter.id}
            data-field={filter.field}
            data-param={filter.param}
            data-comparator={filter.comparator}
            class={selectClass}
          >
            {filter.options.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
      ))}

      <div class="flex items-center gap-4 sm:col-span-2">
        <label class="flex items-center gap-2 text-sm font-medium text-ink-muted">
          <input
            type="checkbox"
            id="filter-free"
            class="h-4 w-4 rounded border-rule focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          />
          Free only
        </label>
        <label class="flex items-center gap-2 text-sm font-medium text-ink-muted">
          <input
            type="checkbox"
            id="filter-verified"
            class="h-4 w-4 rounded border-rule focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          />
          Verified only
        </label>
      </div>
    </div>
  </details>

  <div class="mt-4 flex items-center justify-between gap-4">
    <p id="filter-count" aria-live="polite" class="text-sm text-ink-muted">
      Showing {total} of {total}
    </p>
    <button
      type="button"
      id="filter-clear"
      class="rounded-sm border border-rule bg-surface px-3 py-1.5 text-sm font-medium text-ink-muted hover:bg-pill-fill focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      Clear all
    </button>
  </div>
</div>
