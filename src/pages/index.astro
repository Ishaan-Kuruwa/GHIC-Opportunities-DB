---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpportunityCard from "../components/OpportunityCard.astro";
import FilterBar from "../components/FilterBar.astro";
import data from "../data/opportunities.json";
import type { OpportunitiesData } from "../data/types";

const { meta, opportunities, facets } = data as OpportunitiesData;

// TEMPORARY: "free" is derived from the cost string, not a real data field.
// This only catches costs that literally start with "Free" -- a few entries
// ("Usually free", "Expected free", etc.) are deliberately left out rather than
// guessed at. The durable fix is a real `free: boolean` field added to the data
// schema as part of Phase 7 (Google Sheet as CMS); string-parsing like this will
// silently break the moment someone types "No cost" or "$0" in the sheet instead.
function isFree(cost: string): boolean {
  return cost.trim().toLowerCase().startsWith("free");
}

// Card text alone doesn't include organizer/description, but SPEC requires
// searching across both -- so build the searchable text once per opportunity
// here, at build time, instead of asking the client script to know the data shape.
function searchText(opportunity: (typeof opportunities)[number]): string {
  return `${opportunity.name} ${opportunity.organizer} ${opportunity.description} ${opportunity.category}`.toLowerCase();
}

// Computed once, right now, when the site builds -- not in the visitor's
// browser. That's why the scheduled weekly rebuild
// (.github/workflows/scheduled-rebuild.yml) exists: without it, the hero's
// "next deadline" stat would quietly go stale between edits to
// opportunities.json.
const today = new Date();
const todayIso = today.toISOString().slice(0, 10);

// Hero stat: the single nearest CONFIRMED deadline (not the 45-day list above --
// just "what's next"). Unlike upcomingDeadlines, this excludes estimated dates:
// a hero stat is the first number on the page, so it needs to be a fact, not a
// guess. No cutoff window -- if the only upcoming deadline is 6 months out,
// that's still "what's next."
const nearestConfirmedDeadline = opportunities
  .flatMap((opportunity) =>
    opportunity.deadlines
      .filter((d) => d.kind === "deadline" && !d.estimated && d.precision === "day")
      .map((d) => ({
        opportunityId: opportunity.id,
        opportunityName: opportunity.name,
        date: d.date,
      })),
  )
  .filter((d) => d.date >= todayIso)
  .sort((a, b) => a.date.localeCompare(b.date))[0];

// Same undercounting caveat as isFree() itself -- see its comment above.
const freeCount = opportunities.filter((o) => isFree(o.cost)).length;

// Bento tile sizing (see REDESGIN-V3.md "Layout > Bento grid"). Derived from
// data every build, never hand-assigned -- so a prestige edit or a new
// deadline in the Google Sheet reshuffles the grid on its own.
type TileSize = "standard" | "wide" | "large";

function baseTileSize(prestige: number): TileSize {
  if (prestige >= 9) return "large";
  if (prestige >= 7) return "wide";
  return "standard";
}

function promote(size: TileSize): TileSize {
  return size === "large" ? "large" : size === "wide" ? "large" : "wide";
}

// Separate, narrower window than the 45-day "closing soon" banner above --
// the spec's own promotion rule is 30 days, not 45.
const in30Days = new Date(today);
in30Days.setDate(in30Days.getDate() + 30);
const cutoff30Iso = in30Days.toISOString().slice(0, 10);

// "Confirmed" = not a guess (estimated === false). A milestone ("Registration
// opens") isn't something worth promoting a tile for -- only kind: "deadline".
function hasConfirmedDeadlineSoon(opportunity: (typeof opportunities)[number]): boolean {
  return opportunity.deadlines.some(
    (d) => d.kind === "deadline" && !d.estimated && d.date >= todayIso && d.date <= cutoff30Iso,
  );
}

function tileSizeFor(opportunity: (typeof opportunities)[number]): TileSize {
  const base = baseTileSize(opportunity.ratings.prestige);
  return hasConfirmedDeadlineSoon(opportunity) ? promote(base) : base;
}

// Column/row span only -- content density (which ratings view, whether an
// excerpt shows) is a separate decision passed straight into OpportunityCard
// as the `tileSize` prop, independent of viewport. That split is what makes
// "every tile full width on mobile, but size still controls density" work
// without extra mobile-specific logic: the `md:` prefix here means every tile
// defaults to a plain 1x1 below that breakpoint for free, while the prop-driven
// content decision doesn't care what breakpoint it's rendered at.
function gridSpanClasses(size: TileSize): string {
  if (size === "large") return "md:col-span-2 md:row-span-2";
  if (size === "wide") return "md:col-span-2";
  return "";
}

// Computed once per opportunity, not once per template read -- tileSizeFor()
// gets used for both the <li>'s span classes and the card's content, and
// there's no reason to run the same prestige/deadline check on the same
// opportunity twice per page render.
const tiledOpportunities = opportunities.map((opportunity) => ({
  opportunity,
  size: tileSizeFor(opportunity),
}));

// Homepage-only display order. The sheet's own order (still used everywhere
// else -- the calendar, and prev/next on the detail page) clusters categories
// together, and prestige tends to cluster by category too, so browsing this
// page in canonical order means long stretches of same-size tiles followed by
// a cluster of variety, rather than variety spread across the page. Checked
// against the real data before writing this: canonical order's longest
// same-size run is 11 tiles; this interleave brings that down to 3.
//
// The interleave gives every opportunity a position from 0 to just-under-1
// based only on where it falls within its OWN size bucket, keeping each
// bucket's existing relative order, then sorts everyone by that fraction.
// That spreads a small bucket (3 large tiles) evenly across the whole page
// instead of bunching them -- a fixed L,W,S,L,W,S,... round-robin was tried
// first and rejected: with a split this lopsided (3/12/31) it exhausts the
// large and wide buckets almost immediately and leaves the last 19 of 46
// tiles as a pure-standard run again, just moved to the end of the page
// instead of the middle.
function interleaveBySize(items: typeof tiledOpportunities): typeof tiledOpportunities {
  const seen: Record<TileSize, number> = { large: 0, wide: 0, standard: 0 };
  const totals: Record<TileSize, number> = { large: 0, wide: 0, standard: 0 };
  items.forEach((item) => totals[item.size]++);

  return items
    .map((item, originalIndex) => {
      const fraction = seen[item.size] / totals[item.size];
      seen[item.size]++;
      return { item, originalIndex, fraction };
    })
    // Tie-break on original array index -- fully deterministic, no randomness,
    // and it's what keeps each bucket's own items in their original relative
    // order rather than shuffling them.
    .sort((a, b) => a.fraction - b.fraction || a.originalIndex - b.originalIndex)
    .map(({ item }) => item);
}

const displayOrder = interleaveBySize(tiledOpportunities);

const DEADLINE_MONTH_NAMES = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];

function shortDate(iso: string): string {
  const [y, m, d] = iso.split("-").map((n) => parseInt(n, 10));
  return `${DEADLINE_MONTH_NAMES[m - 1]} ${d}`;
}
---

<BaseLayout title={meta.title} description={meta.description}>
  <main class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-semibold leading-tight text-ink sm:text-5xl">
      You&rsquo;ve probably never heard of most of these &mdash; <span class="tabular text-accent">{meta.count}</span> competitions,
      internships and programs, <span class="tabular text-accent">{freeCount}</span> of them free.
    </h1>

    <dl class="mt-6 flex flex-col gap-4 text-sm sm:flex-row sm:flex-wrap sm:gap-x-8 sm:gap-y-2">
      <div>
        <dt class="text-ink-muted">Opportunities</dt>
        <dd class="tabular text-2xl font-semibold text-ink">{meta.count}</dd>
      </div>
      <div class="border-l border-hairline pl-4 sm:pl-8">
        <dt class="text-ink-muted">Free to enter</dt>
        <dd class="tabular text-2xl font-semibold text-ink">{freeCount}</dd>
      </div>
      {nearestConfirmedDeadline && (
        <div class="border-l border-hairline pl-4 sm:pl-8">
          <dt class="text-ink-muted">Next deadline</dt>
          <dd>
            <a
              href={`/opportunity/${nearestConfirmedDeadline.opportunityId}`}
              class="inline-block text-2xl font-semibold text-accent underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span class="tabular">{shortDate(nearestConfirmedDeadline.date)}</span>
              <span class="block text-sm font-medium text-ink"
                >{nearestConfirmedDeadline.opportunityName}</span
              >
            </a>
          </dd>
        </div>
      )}
    </dl>

    <!--
      This is the site's only remaining link to /calendar -- the "Closing
      soon" banner that used to hold it was cut as redundant with the Next
      deadline stat above (see git history). Kept unconditional, and
      separate from the `nearestConfirmedDeadline &&` block above it, so
      /calendar never goes fully unlinked on the rare build where no
      confirmed deadline exists.
    -->
    <a
      href="/calendar"
      class="mt-2 inline-block text-sm text-ink-muted underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      Full calendar &rarr;
    </a>

    <nav aria-label="Guides" class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a
        href="/guides/start-here"
        class="font-medium text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Start here
      </a>
      <a
        href="/guides/free-learning-stack"
        class="font-medium text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Free learning stack
      </a>
      <a
        href="/guides/how-we-verify"
        class="font-medium text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        How we verify
      </a>
      <a
        href="/guides/about"
        class="font-medium text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        About
      </a>
    </nav>

    <FilterBar facets={facets} total={opportunities.length} />

    <ul
      id="opportunity-list"
      class="mt-8 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-3 lg:grid-cols-4 grid-flow-row-dense auto-rows-[minmax(14rem,auto)]"
    >
      {displayOrder.map(({ opportunity, size }) => (
        <li
          class={gridSpanClasses(size)}
          data-opportunity
          data-type={opportunity.type}
          data-category={opportunity.category}
          data-free={isFree(opportunity.cost)}
          data-verified={opportunity.verified}
          data-effort={opportunity.ratings.effort}
          data-competitiveness={opportunity.ratings.competitiveness}
          data-skills={opportunity.ratings.skills}
          data-club-fit={opportunity.ratings.clubFit}
          data-search={searchText(opportunity)}
        >
          <OpportunityCard opportunity={opportunity} tileSize={size} />
        </li>
      ))}
    </ul>

    <div
      id="filter-empty-state"
      hidden
      class="mt-8 rounded-sm border border-hairline bg-pill-fill p-8 text-center"
    >
      <p class="text-ink-muted">No opportunities match these filters.</p>
      <button
        type="button"
        id="filter-empty-clear"
        class="mt-4 rounded-sm border border-hairline bg-tile px-3 py-1.5 text-sm font-medium text-ink-muted hover:bg-pill-fill focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Clear filters
      </button>
    </div>
  </main>

  <script src="../scripts/filters.js"></script>
</BaseLayout>
