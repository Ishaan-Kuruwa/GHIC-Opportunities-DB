---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpportunityCard from "../components/OpportunityCard.astro";
import FilterBar from "../components/FilterBar.astro";
import data from "../data/opportunities.json";
import type { OpportunitiesData } from "../data/types";

const { meta, opportunities, facets } = data as OpportunitiesData;

// TEMPORARY: "free" is derived from the cost string, not a real data field.
// This only catches costs that literally start with "Free" -- a few entries
// ("Usually free", "Expected free", etc.) are deliberately left out rather than
// guessed at. The durable fix is a real `free: boolean` field added to the data
// schema as part of Phase 7 (Google Sheet as CMS); string-parsing like this will
// silently break the moment someone types "No cost" or "$0" in the sheet instead.
function isFree(cost: string): boolean {
  return cost.trim().toLowerCase().startsWith("free");
}

// Card text alone doesn't include organizer/description, but SPEC requires
// searching across both -- so build the searchable text once per opportunity
// here, at build time, instead of asking the client script to know the data shape.
function searchText(opportunity: (typeof opportunities)[number]): string {
  return `${opportunity.name} ${opportunity.organizer} ${opportunity.description} ${opportunity.category}`.toLowerCase();
}

// "Closing soon" banner: computed once, right now, when the site builds --
// not in the visitor's browser. That's why the scheduled weekly rebuild
// (.github/workflows/scheduled-rebuild.yml) exists: without it, this list
// would quietly go stale between edits to opportunities.json.
//
// Only kind: "deadline" (not "milestone" -- "Theme announced" isn't
// something to warn about) and only precision: "day" (a countdown against a
// fuzzy "late June" guess would be misleading in the same way an .ics file
// for it would be -- see src/data/types.ts).
const today = new Date();
const in45Days = new Date(today);
in45Days.setDate(in45Days.getDate() + 45);
const todayIso = today.toISOString().slice(0, 10);
const cutoffIso = in45Days.toISOString().slice(0, 10);

const upcomingDeadlines = opportunities
  .flatMap((opportunity) =>
    opportunity.deadlines
      .filter((d) => d.kind === "deadline" && d.precision === "day")
      .map((d) => ({
        opportunityId: opportunity.id,
        opportunityName: opportunity.name,
        label: d.label,
        date: d.date,
      })),
  )
  // Plain ISO string comparison works here because YYYY-MM-DD sorts the same
  // lexicographically as chronologically -- no need for Date math.
  .filter((d) => d.date >= todayIso && d.date <= cutoffIso)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);

const DEADLINE_MONTH_NAMES = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];

function shortDate(iso: string): string {
  const [y, m, d] = iso.split("-").map((n) => parseInt(n, 10));
  return `${DEADLINE_MONTH_NAMES[m - 1]} ${d}`;
}
---

<BaseLayout title={meta.title} description={meta.description}>
  <main class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-black text-3xl uppercase tracking-tight text-ink">{meta.title}</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">{meta.description}</p>

    <nav aria-label="Guides" class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a
        href="/guides/start-here"
        class="font-extrabold uppercase tracking-tight text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Start here
      </a>
      <a
        href="/guides/free-learning-stack"
        class="font-extrabold uppercase tracking-tight text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Free learning stack
      </a>
      <a
        href="/guides/how-we-verify"
        class="font-extrabold uppercase tracking-tight text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        How we verify
      </a>
      <a
        href="/guides/about"
        class="font-extrabold uppercase tracking-tight text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        About
      </a>
    </nav>

    {upcomingDeadlines.length > 0 && (
      <div class="mt-6 border-4 border-ink bg-pill-fill p-4">
        <p class="text-sm font-extrabold uppercase tracking-tight text-ink">Closing soon</p>
        <ul class="mt-2 list-none space-y-1.5 p-0 text-sm">
          {upcomingDeadlines.map((d) => (
            <li>
              <a
                href={`/opportunity/${d.opportunityId}`}
                class="font-medium text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                {d.opportunityName}
              </a>
              <span class="text-ink-muted"> -- {d.label}, {shortDate(d.date)}</span>
            </li>
          ))}
        </ul>
        <a
          href="/calendar"
          class="mt-2 inline-block text-sm text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          See the full calendar &rarr;
        </a>
      </div>
    )}

    <FilterBar facets={facets} total={opportunities.length} />

    <ul
      id="opportunity-list"
      class="mt-8 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3"
    >
      {opportunities.map((opportunity) => (
        <li
          data-opportunity
          data-type={opportunity.type}
          data-category={opportunity.category}
          data-free={isFree(opportunity.cost)}
          data-verified={opportunity.verified}
          data-effort={opportunity.ratings.effort}
          data-competitiveness={opportunity.ratings.competitiveness}
          data-skills={opportunity.ratings.skills}
          data-club-fit={opportunity.ratings.clubFit}
          data-search={searchText(opportunity)}
        >
          <OpportunityCard opportunity={opportunity} />
        </li>
      ))}
    </ul>

    <div
      id="filter-empty-state"
      hidden
      class="mt-8 border-4 border-ink bg-pill-fill p-8 text-center"
    >
      <p class="text-ink-muted">No opportunities match these filters.</p>
      <button
        type="button"
        id="filter-empty-clear"
        class="shadow-brutal mt-4 border-4 border-ink bg-surface px-3 py-1.5 text-sm font-extrabold uppercase tracking-tight text-ink hover:bg-pill-fill focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Clear filters
      </button>
    </div>
  </main>

  <script src="../scripts/filters.js"></script>
</BaseLayout>
