---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpportunityCard from "../components/OpportunityCard.astro";
import data from "../data/opportunities.json";
import type { OpportunitiesData } from "../data/types";

const { meta, opportunities } = data as OpportunitiesData;
---

<BaseLayout title={meta.title} description={meta.description}>
  <main class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900">{meta.title}</h1>
    <p class="mt-2 max-w-2xl text-gray-600">{meta.description}</p>

    <ul class="mt-8 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
      {opportunities.map((opportunity) => (
        <li>
          <OpportunityCard opportunity={opportunity} />
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
