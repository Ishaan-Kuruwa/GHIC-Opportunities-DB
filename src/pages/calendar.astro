---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/opportunities.json";
import type { Deadline, OpportunitiesData } from "../data/types";
import { slugify } from "../utils/slugify.mjs";

const { meta, opportunities } = data as OpportunitiesData;

interface Row extends Deadline {
  opportunityId: string;
  opportunityName: string;
}

const rows: Row[] = opportunities.flatMap((opportunity) =>
  opportunity.deadlines.map((deadline) => ({
    ...deadline,
    opportunityId: opportunity.id,
    opportunityName: opportunity.name,
  })),
);

const estimatedCount = rows.filter((r) => r.estimated).length;

// "School year" runs August -> July. Build 12 month buckets starting from the
// first year in meta.schoolYear ("2026-27" -> 2026), regardless of which
// months actually have entries, so the page always reads as one full year.
const [startYear] = meta.schoolYear.split("-").map((y) => parseInt(y, 10));
const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

const months = Array.from({ length: 12 }, (_, i) => {
  const monthIndex = (7 + i) % 12; // 7 = August (0-indexed)
  const year = monthIndex >= 7 ? startYear : startYear + 1;
  const key = `${year}-${String(monthIndex + 1).padStart(2, "0")}`;
  return {
    key,
    label: `${MONTH_NAMES[monthIndex]} ${year}`,
    rows: rows
      .filter((r) => r.date.startsWith(key))
      .sort((a, b) => a.date.localeCompare(b.date)),
  };
}).filter((month) => month.rows.length > 0);

// Matches the filenames scripts/generate-ics.mjs actually writes -- both
// import the same slugify() so these can't drift apart.
function icsHref(row: Row): string {
  return `/ics/${row.opportunityId}--${slugify(row.label)}.ics`;
}

function displayDate(row: Row): string {
  const [y, m, d] = row.date.split("-").map((n) => parseInt(n, 10));
  const month = MONTH_NAMES[m - 1];
  if (row.precision === "day") return `${month} ${d}, ${y}`;
  if (row.precision === "month-part") {
    const part = d <= 10 ? "early" : d <= 20 ? "mid" : "late";
    return `${part.charAt(0).toUpperCase() + part.slice(1)} ${month} ${y}`;
  }
  return `${month} ${y}`;
}
---

<BaseLayout
  title={`Deadline calendar | ${meta.title}`}
  description="Every deadline and key date across the school year, grouped by month."
>
  <main class="mx-auto max-w-3xl px-4 py-8">
    <nav aria-label="Breadcrumb">
      <a
        href="/"
        class="text-sm text-blue-700 underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      >
        &larr; Back to all opportunities
      </a>
    </nav>

    <h1 class="mt-4 text-2xl font-bold text-gray-900">Deadline calendar</h1>
    <p class="mt-2 text-gray-600">
      Every deadline and key date we know about for the {meta.schoolYear} school year, grouped by
      month.
    </p>

    <a
      href="/ics/all-deadlines.ics"
      download
      class="mt-4 inline-block rounded-md bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
      Add all deadlines to your calendar
    </a>
    <p class="mt-1 text-xs text-gray-500">
      Only includes entries with an exact date -- a date only described as "late June" can't
      become a real calendar event. Those entries also won't have their own individual "Add to
      calendar" link below.
    </p>

    <div class="mt-6 rounded-md border border-amber-400 bg-amber-50 p-4 text-sm text-amber-900">
      <p class="font-semibold">
        {estimatedCount} of {rows.length} dates on this page are estimates, not confirmed dates.
      </p>
      <p class="mt-1">
        Most organizers hadn't published this cycle's exact dates yet when we last checked, so
        most of what's below is a best guess based on when the program has run in past years or
        on vague wording like "late spring." Every estimated date is shaded like this box and
        says exactly what it's guessed from. Always confirm on the organizer's own site before
        you rely on a date here.
      </p>
    </div>

    <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs text-gray-500">
      <div class="flex items-center gap-1.5">
        <span class="inline-block h-3 w-3 rounded-sm border border-gray-300 bg-white"></span>
        <dt class="sr-only">Confirmed</dt>
        <dd>Confirmed date</dd>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="inline-block h-3 w-3 rounded-sm border border-amber-400 bg-amber-50"></span>
        <dt class="sr-only">Estimated</dt>
        <dd>Estimated date</dd>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="rounded border border-gray-300 px-1 py-px font-medium">deadline</span>
        <dd>Something you can miss</dd>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="rounded border border-gray-300 px-1 py-px font-medium">milestone</span>
        <dd>Informational -- nothing due</dd>
      </div>
    </dl>

    {months.map((month) => (
      <section class="mt-10">
        <h2 class="text-lg font-semibold text-gray-900">{month.label}</h2>
        <ul class="mt-3 list-none space-y-2 p-0">
          {month.rows.map((row) => (
            <li
              class:list={[
                "rounded-md border p-3",
                row.estimated
                  ? "border-amber-400 bg-amber-50"
                  : "border-gray-200 bg-white",
              ]}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <a
                  href={`/opportunity/${row.opportunityId}`}
                  class="font-semibold text-gray-900 underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                >
                  {row.opportunityName}
                </a>
                <span
                  class:list={[
                    "rounded border px-1.5 py-0.5 text-xs font-medium",
                    row.estimated
                      ? "border-amber-400 text-amber-900"
                      : "border-gray-300 text-gray-600",
                  ]}
                >
                  {displayDate(row)}
                </span>
              </div>
              <p class="mt-1 text-sm text-gray-700">
                {row.label}
                <span class="ml-2 rounded border border-gray-300 px-1 py-px text-xs font-medium text-gray-500">
                  {row.kind}
                </span>
              </p>
              {row.estimated && (
                <p class="mt-1 text-xs text-amber-800">
                  Estimated -- {row.estimatedFrom}
                </p>
              )}
              {row.precision === "day" && (
                <a
                  href={icsHref(row)}
                  download
                  class="mt-2 inline-block text-xs font-medium text-blue-700 underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                >
                  Add to calendar (.ics)
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>
