---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RatingMeter from "../../components/RatingMeter.astro";
import data from "../../data/opportunities.json";
import type { Opportunity, OpportunitiesData } from "../../data/types";

export function getStaticPaths() {
  const { opportunities } = data as OpportunitiesData;
  return opportunities.map((opportunity, index) => ({
    params: { id: opportunity.id },
    props: {
      opportunity,
      // Wrap around so every page has both a prev and a next -- nobody hits a dead end.
      previous: opportunities[(index - 1 + opportunities.length) % opportunities.length],
      next: opportunities[(index + 1) % opportunities.length],
    },
  }));
}

interface Props {
  opportunity: Opportunity;
  previous: Opportunity;
  next: Opportunity;
}

const { opportunity, previous, next } = Astro.props;

const lastVerifiedDisplay = new Date(opportunity.lastVerified + "T00:00:00").toLocaleDateString(
  "en-US",
  { year: "numeric", month: "long", day: "numeric" },
);

const pageTitle = `${opportunity.name} | ${opportunity.category}`;
const pageDescription = `${opportunity.name} -- a ${opportunity.category.toLowerCase()} ${opportunity.type.toLowerCase()} for high school students, run by ${opportunity.organizer}.`;

const factRows: [string, string][] = [
  ["Eligibility", opportunity.eligibility],
  ["Format", opportunity.format],
  ["Timing", opportunity.timing],
  ["Cost", opportunity.cost],
  ["Commitment", opportunity.commitment],
  ["Payoff", opportunity.payoff],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <nav aria-label="Breadcrumb">
      <a
        href="/"
        class="text-sm text-accent underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        &larr; Back to all opportunities
      </a>
    </nav>

    <article class="mt-6">
      <h1 class="text-3xl font-semibold text-ink">{opportunity.name}</h1>
      <p class="mt-2 text-ink-muted">
        {opportunity.type} &middot; {opportunity.category} &middot; {opportunity.organizer}
      </p>

      <p class="mt-3">
        <span class="inline-block rounded-sm bg-pill-fill px-2 py-0.5 text-xs font-medium text-ink-muted">
          {opportunity.prestigeTier}
        </span>
      </p>

      {!opportunity.verified && (
        <div class="mt-6 rounded-sm border border-caution-border bg-caution-fill p-4 text-sm text-caution-text">
          <p class="font-semibold">Not yet verified</p>
          <p class="mt-1">
            This entry hasn't been confirmed against the organizer's official site recently.
            Please double-check deadlines, eligibility, and cost yourself before relying on it.
          </p>
        </div>
      )}

      <p class="tabular mt-6 text-sm text-ink-faint">
        {opportunity.confidence} &middot; last verified {lastVerifiedDisplay}
      </p>

      {opportunity.url && (
        <a
          href={opportunity.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block rounded-sm bg-accent px-4 py-2 font-semibold text-floor hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Visit the official site
        </a>
      )}

      <p class="mt-8 whitespace-pre-line text-ink">{opportunity.description}</p>

      {/* Hairline-ruled rows rather than boxed cards -- reads as a reference
          entry, and keeps the eye moving down one column on a phone. */}
      <dl class="mt-10 border-t border-hairline">
        {factRows.map(([label, value]) => (
          <div class="grid grid-cols-1 gap-1 border-b border-hairline py-3 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="text-sm font-semibold text-ink-faint">{label}</dt>
            <dd class="text-ink">{value}</dd>
          </div>
        ))}
      </dl>

      {opportunity.notes && (
        <div class="mt-8">
          <h2 class="text-lg font-semibold text-ink">Notes</h2>
          <p class="mt-2 text-ink">{opportunity.notes}</p>
        </div>
      )}

      <div class="mt-10">
        <h2 class="text-lg font-semibold text-ink">Ratings</h2>
        <div class="mt-4">
          <RatingMeter
            ratings={opportunity.ratings}
            difficultyIndex={opportunity.difficultyIndex}
            showDifficulty
          />
        </div>
      </div>
    </article>

    <nav
      aria-label="Opportunity navigation"
      class="mt-12 grid grid-cols-2 gap-6 border-t border-hairline pt-6"
    >
      <a
        href={`/opportunity/${previous.id}`}
        class="rounded-sm p-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <span class="block text-ink-faint">&larr; Previous</span>
        <span class="mt-1 block font-medium text-accent">{previous.name}</span>
      </a>
      <a
        href={`/opportunity/${next.id}`}
        class="rounded-sm p-2 text-right text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <span class="block text-ink-faint">Next &rarr;</span>
        <span class="mt-1 block font-medium text-accent">{next.name}</span>
      </a>
    </nav>
  </main>
</BaseLayout>
